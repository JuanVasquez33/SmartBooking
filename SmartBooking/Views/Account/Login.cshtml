@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar sesión - SmartBooking</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Sora:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/Account/Login.css" asp-append-version="true" />
</head>
<body>

    <div class="login-wrapper">

        <!-- Panel izquierdo: branding -->
        <div class="brand-panel">
            <div class="brand-bg-shapes">
                <div class="shape shape-1"></div>
                <div class="shape shape-2"></div>
                <div class="shape shape-3"></div>
            </div>

            <div class="brand-content">
                <div class="brand-logo">
                    <div class="logo-icon">
                        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="6" y="8" width="36" height="34" rx="4" stroke="white" stroke-width="2.5" fill="none"/>
                            <path d="M16 6v4M32 6v4" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
                            <path d="M6 18h36" stroke="white" stroke-width="2.5"/>
                            <rect x="13" y="25" width="6" height="6" rx="1.5" fill="white" opacity="0.9"/>
                            <rect x="21" y="25" width="6" height="6" rx="1.5" fill="white" opacity="0.6"/>
                            <rect x="29" y="25" width="6" height="6" rx="1.5" fill="white" opacity="0.3"/>
                            <rect x="13" y="33" width="6" height="4" rx="1.5" fill="white" opacity="0.6"/>
                            <rect x="21" y="33" width="6" height="4" rx="1.5" fill="white" opacity="0.4"/>
                        </svg>
                    </div>
                    <span class="logo-name">SmartBooking</span>
                </div>

                <div class="brand-hero">
                    <h1>Agenda inteligente<br/>para profesionales</h1>
                    <p>Gestiona tus citas, clientes y servicios desde un solo lugar. Simple, rápido y sin complicaciones.</p>
                </div>

                <div class="brand-stats">
                    <div class="stat">
                        <span class="stat-number">+2k</span>
                        <span class="stat-label">Profesionales</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat">
                        <span class="stat-number">98%</span>
                        <span class="stat-label">Satisfacción</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat">
                        <span class="stat-number">24/7</span>
                        <span class="stat-label">Disponible</span>
                    </div>
                </div>
                 
                @* <div class="floating-card card-1">
                    <div class="card-dot confirmed"></div>
                    <div class="card-info">
                        <span class="card-title">Cita confirmada</span>
                        <span class="card-sub">Hoy, 3:00 PM · Juan Vásquez</span>
                    </div>
                </div>

                <div class="floating-card card-2">
                    <div class="card-dot pending"></div>
                    <div class="card-info">
                        <span class="card-title">Nueva reserva</span>
                        <span class="card-sub">Mañana, 10:00 AM</span>
                    </div>
                </div> *@
            </div>
        </div>

        <!-- Panel derecho: formulario -->
        <div class="form-panel">
            <div class="form-container">

                <div class="form-top">
                    <div class="form-logo-mobile">
                        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="6" y="8" width="36" height="34" rx="4" stroke="var(--primary)" stroke-width="2.5" fill="none"/>
                            <path d="M16 6v4M32 6v4" stroke="var(--primary)" stroke-width="2.5" stroke-linecap="round"/>
                            <path d="M6 18h36" stroke="var(--primary)" stroke-width="2.5"/>
                            <rect x="13" y="25" width="6" height="6" rx="1.5" fill="var(--primary)" opacity="0.9"/>
                            <rect x="21" y="25" width="6" height="6" rx="1.5" fill="var(--primary)" opacity="0.6"/>
                        </svg>
                        <span>SmartBooking</span>
                    </div>
                    <h2>Bienvenido de nuevo</h2>
                    <p>Ingresa a tu panel de gestión de citas</p>
                </div>

                <!-- Botón Google via Auth0 -->
                <a asp-controller="Account" asp-action="LoginWithGoogle" class="btn-google">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                    </svg>
                    Continuar con Google
                </a>

                <div class="separator">
                    <span>o inicia con tu correo</span>
                </div>

                <!-- Formulario email/password que redirige a Auth0 -->
                <form asp-controller="Account" asp-action="Login" method="post" id="loginForm">
                    @Html.AntiForgeryToken()

                    <div class="field-group">
                        <label for="email">Correo electrónico</label>
                        <div class="field-wrapper">
                            <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                <polyline points="22,6 12,12 2,6"/>
                            </svg>
                            <input type="email" id="email" name="email" placeholder="tu@correo.com" autocomplete="email" required />
                        </div>
                    </div>

                    <div class="field-group">
                        <div class="label-row">
                            <label for="password">Contraseña</label>
                            <a href="#" class="forgot-link">¿Olvidaste tu contraseña?</a>
                        </div>
                        <div class="field-wrapper">
                            <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                            </svg>
                            <input type="password" id="password" name="password" placeholder="••••••••" autocomplete="current-password" required />
                            <button type="button" class="toggle-pass" onclick="togglePassword()">
                                <svg id="eyeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn-login">
                        <span>Iniciar sesión</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M5 12h14M12 5l7 7-7 7"/>
                        </svg>
                    </button>
                </form>

                <div class="form-footer">
                    <p>¿No tienes cuenta? <a asp-controller="Account" asp-action="Register">Regístrate gratis</a></p>
                </div>

            </div>
        </div>

    </div>

    <script>
        function togglePassword() {
            const input = document.getElementById('password');
            input.type = input.type === 'password' ? 'text' : 'password';
        }
    </script>
</body>
</html>
