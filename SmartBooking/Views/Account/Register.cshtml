@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Crear cuenta - SmartBooking</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Sora:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/Account/Login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Account/Register.css" asp-append-version="true" />
</head>
<body>

    <div class="login-wrapper">

        <!-- Panel izquierdo -->
        <div class="brand-panel">
            <div class="brand-bg-shapes">
                <div class="shape shape-1"></div>
                <div class="shape shape-2"></div>
                <div class="shape shape-3"></div>
            </div>
            <div class="brand-content">
                <div class="brand-logo">
                    <div class="logo-icon">
                        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="6" y="8" width="36" height="34" rx="4" stroke="white" stroke-width="2.5" fill="none"/>
                            <path d="M16 6v4M32 6v4" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
                            <path d="M6 18h36" stroke="white" stroke-width="2.5"/>
                            <rect x="13" y="25" width="6" height="6" rx="1.5" fill="white" opacity="0.9"/>
                            <rect x="21" y="25" width="6" height="6" rx="1.5" fill="white" opacity="0.6"/>
                            <rect x="29" y="25" width="6" height="6" rx="1.5" fill="white" opacity="0.3"/>
                        </svg>
                    </div>
                    <span class="logo-name">SmartBooking</span>
                </div>
                <div class="brand-hero">
                    <h1>Empieza a crecer<br/>desde hoy</h1>
                    <p>Crea tu cuenta gratis y ten tu agenda profesional lista en menos de 5 minutos.</p>
                </div>
                <div class="register-benefits">
                    <div class="benefit">
                        <span class="benefit-icon">✓</span>
                        <span>Gratis para siempre en el plan básico</span>
                    </div>
                    <div class="benefit">
                        <span class="benefit-icon">✓</span>
                        <span>Sin tarjeta de crédito requerida</span>
                    </div>
                    <div class="benefit">
                        <span class="benefit-icon">✓</span>
                        <span>Configuración en menos de 5 minutos</span>
                    </div>
                    <div class="benefit">
                        <span class="benefit-icon">✓</span>
                        <span>Cancela cuando quieras</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Panel derecho -->
        <div class="form-panel">
            <div class="form-container">

                <div class="form-top">
                    <div class="form-logo-mobile">
                        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="6" y="8" width="36" height="34" rx="4" stroke="var(--primary)" stroke-width="2.5" fill="none"/>
                            <path d="M16 6v4M32 6v4" stroke="var(--primary)" stroke-width="2.5" stroke-linecap="round"/>
                            <path d="M6 18h36" stroke="var(--primary)" stroke-width="2.5"/>
                            <rect x="13" y="25" width="6" height="6" rx="1.5" fill="var(--primary)" opacity="0.9"/>
                        </svg>
                        <span>SmartBooking</span>
                    </div>
                    <h2>Crear cuenta</h2>
                    <p>¿Ya tienes cuenta? <a asp-controller="Account" asp-action="Login">Inicia sesión</a></p>
                </div>

                <!-- Google -->
                <a asp-controller="Account" asp-action="LoginWithGoogle" class="btn-google">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                    </svg>
                    Registrarse con Google
                </a>

                <div class="separator">
                    <span>o con correo electrónico</span>
                </div>

                @if (!string.IsNullOrEmpty(ViewBag.Error))
                {
                    <div class="alert-error">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        @ViewBag.Error
                    </div>
                }

                <form asp-controller="Account" asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <div class="field-group">
                        <label for="nombre">Nombre completo</label>
                        <div class="field-wrapper">
                            <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                            </svg>
                            <input type="text" id="nombre" name="nombre" placeholder="Juan Pérez" required />
                        </div>
                    </div>

                    <div class="field-group">
                        <label for="email">Correo electrónico</label>
                        <div class="field-wrapper">
                            <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,12 2,6"/>
                            </svg>
                            <input type="email" id="email" name="email" placeholder="tu@correo.com" required />
                        </div>
                    </div>

                    <div class="field-group">
                        <label for="password">Contraseña</label>
                        <div class="field-wrapper">
                            <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                            </svg>
                            <input type="password" id="password" name="password" placeholder="Mínimo 8 caracteres" required minlength="8" />
                            <button type="button" class="toggle-pass" onclick="togglePassword()">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                                </svg>
                            </button>
                        </div>
                        <div class="password-strength" id="strengthBar">
                            <div class="strength-fill" id="strengthFill"></div>
                        </div>
                        <span class="strength-label" id="strengthLabel"></span>
                    </div>

                    <button type="submit" class="btn-login">
                        <span>Crear cuenta</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M5 12h14M12 5l7 7-7 7"/>
                        </svg>
                    </button>

                    <p class="terms-note">
                        Al registrarte aceptas nuestros <a href="#">Términos de uso</a> y <a href="#">Política de privacidad</a>
                    </p>
                </form>

            </div>
        </div>
    </div>

    <script>
        function togglePassword() {
            const input = document.getElementById('password');
            input.type = input.type === 'password' ? 'text' : 'password';
        }

        // Password strength
        document.getElementById('password').addEventListener('input', function () {
            const val = this.value;
            const fill = document.getElementById('strengthFill');
            const label = document.getElementById('strengthLabel');

            let strength = 0;
            if (val.length >= 8) strength++;
            if (/[A-Z]/.test(val)) strength++;
            if (/[0-9]/.test(val)) strength++;
            if (/[^A-Za-z0-9]/.test(val)) strength++;

            const levels = [
                { width: '0%', color: 'transparent', text: '' },
                { width: '25%', color: '#ef4444', text: 'Muy débil' },
                { width: '50%', color: '#f59e0b', text: 'Débil' },
                { width: '75%', color: '#3b82f6', text: 'Buena' },
                { width: '100%', color: '#22c55e', text: 'Excelente' },
            ];

            fill.style.width = levels[strength].width;
            fill.style.background = levels[strength].color;
            label.textContent = levels[strength].text;
            label.style.color = levels[strength].color;
        });
    </script>
</body>
</html>
